PORT=3000
NODE_ENV=development

# Local PostgreSQL (see docker-compose.yml in the repo root)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs_training
DB_USER=postgres
DB_PASSWORD=postgres

# Production: single connection string (e.g. Railway)
# DATABASE_URL=

# Required: long random strings, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# Required only for `npm run seed:admin`
ADMIN_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_USERNAME=

# Password reset e-mails (Gmail API)
FRONTEND_URL=http://localhost:8081
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
